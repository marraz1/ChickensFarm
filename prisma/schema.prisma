// ChickensFarm — full data model (all phases), see project plan for rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FarmRole {
  OWNER
  WORKER
}

enum BirdType {
  HEN
  GOOSE
  DUCK
  TURKEY
  OTHER
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

enum LossReasonType {
  DISEASE
  PREDATOR
  OTHER
}

enum ExpenseCategory {
  FEED
  VITAMINS
  MEDICINE
  PRODUCTIVITY
  OTHER
}

enum EggQuality {
  HEALTHY
  BROKEN
}

enum BirdCategory {
  CHICK // viščiukai (išperinti jaunikliai)
  PULLET // jauniklės vištos
  COCKEREL // jaunikliai gaidukai
  LAYER // dedeklės
  ROOSTER // gaidukai
  OTHER // kita
}

enum BirdGroupEventType {
  INITIAL
  MANUAL_ADJUSTMENT
  LOSS
  INCUBATION_HATCH
  PURCHASE
  SALE
}

// Buying and selling live birds. One enum rather than two models: both sides
// record the same shape (date, head count, unit price, total, counterparty) and
// differ only in sign — purchases are money out, sales money in.
enum BirdTransactionType {
  PURCHASE
  SALE
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String?
  createdAt           DateTime             @default(now())
  farmsOwned          Farm[]               @relation("FarmOwner")
  farmMemberships     FarmUser[]
  resetTokens         PasswordResetToken[]
  birdGroupEvents     BirdGroupEvent[]     @relation("EventCreatedBy")
  notificationSetting NotificationSetting?
  pushSubscriptions   PushSubscription[]

  @@map("users")
}

// One row per user, created lazily on the first save — existing users simply
// have none, so no backfill is needed. The reminder batch scans every enabled
// row on each run; there is no extra index because the table holds one row per
// user and the scan is sub-millisecond at this scale.
model NotificationSetting {
  id         String              @id @default(cuid())
  userId     String              @unique
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled    Boolean             @default(false)
  message    String              @db.VarChar(300)
  sendTime   String              @db.VarChar(5) // "HH:mm" in the user's own time zone
  timeZone   String              @default("Europe/Vilnius") // IANA name
  // Channels are independent rather than one enum: a reminder is worth having in
  // both places — push is instant but easy to swipe away, email is the record.
  emailEnabled Boolean           @default(true)
  pushEnabled  Boolean           @default(false)
  // Where reminders go. Null means "wherever the account email points", which
  // keeps existing rows working and keeps following the account if it changes —
  // a copy of the address would silently go stale.
  email      String?
  // The local day this setting was last acted on — either a reminder was sent,
  // or it was deliberately skipped because the data was already there. Doubles
  // as the compare-and-set key that keeps overlapping cron runs idempotent.
  lastRunOn  DateTime?           @db.Date
  // The last reminder actually delivered, shown in the UI so a silently broken
  // schedule is noticeable.
  lastSentAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("notification_settings")
}

// One row per browser/device, not per user: the same account installed on a
// phone and a laptop holds two subscriptions and both should ring.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The push service URL identifies the device. Unique so a browser that
  // re-subscribes updates its row instead of accumulating duplicates.
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  // Set on every successful delivery, so a stale device is visible.
  lastUsedAt DateTime?

  @@index([userId])
  @@map("push_subscriptions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Farm {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation("FarmOwner", fields: [ownerId], references: [id])
  name      String
  location  String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  farmUsers        FarmUser[]
  breeds           Breed[]
  birdGroups       BirdGroup[]
  motherHens       MotherHen[]
  eggCollections   EggCollection[]
  eggSales         EggSale[]
  eggConsumptions  EggConsumption[]
  losses           Loss[]
  expenses         Expense[]
  incubationCycles IncubationCycle[]
  birdGroupEvents  BirdGroupEvent[]
  birdTransactions BirdTransaction[]

  @@index([ownerId])
  @@map("farms")
}

model FarmUser {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      FarmRole @default(OWNER)
  createdAt DateTime @default(now())

  @@unique([farmId, userId])
  @@index([userId])
  @@map("farm_users")
}

model Breed {
  id          String   @id @default(cuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name        String
  birdType    BirdType
  description String?
  createdAt   DateTime @default(now())

  birdGroups BirdGroup[]

  @@index([farmId])
  @@map("breeds")
}

model BirdGroup {
  id                  String   @id @default(cuid())
  farmId              String
  farm                Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  breedId             String
  breed               Breed        @relation(fields: [breedId], references: [id], onDelete: Restrict)
  name                String? // optional free-text label (e.g. "Vištidė A"), shown alongside the breed
  sex                 Sex          @default(UNKNOWN)
  category            BirdCategory @default(OTHER)
  quantity            Int
  birthOrAcquiredDate DateTime @db.Date
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  motherHens        MotherHen[]
  losses            Loss[]
  eggCollections    EggCollection[]
  events            BirdGroupEvent[]
  birdTransactions  BirdTransaction[]
  hatchedFromCycles IncubationCycle[] @relation("EggSourceGroup")
  hatchedIntoCycles IncubationCycle[] @relation("ResultingGroup")

  @@index([farmId])
  @@index([farmId, breedId])
  @@map("bird_groups")
}

// F4.3 — historical audit log of every quantity change
model BirdGroupEvent {
  id             String             @id @default(cuid())
  birdGroupId    String
  birdGroup      BirdGroup          @relation(fields: [birdGroupId], references: [id], onDelete: Cascade)
  farmId         String
  farm           Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  eventType      BirdGroupEventType
  quantityDelta  Int
  quantityBefore Int
  quantityAfter  Int
  sourceType     String?
  sourceId       String?
  note           String?
  createdAt      DateTime           @default(now())
  createdById    String
  createdBy      User               @relation("EventCreatedBy", fields: [createdById], references: [id])

  @@index([birdGroupId, createdAt])
  @@index([farmId])
  @@map("bird_group_events")
}

model MotherHen {
  id          String     @id @default(cuid())
  farmId      String
  farm        Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  birdGroupId String?
  birdGroup   BirdGroup? @relation(fields: [birdGroupId], references: [id], onDelete: SetNull)
  name        String
  photoUrl    String?
  description String?
  createdAt   DateTime   @default(now())

  logs MotherHenLog[]

  @@index([farmId])
  @@map("mother_hens")
}

model MotherHenLog {
  id          String    @id @default(cuid())
  motherHenId String
  motherHen   MotherHen @relation(fields: [motherHenId], references: [id], onDelete: Cascade)
  entryDate   DateTime  @db.Date
  note        String?
  photoUrl    String?
  createdAt   DateTime  @default(now())

  @@index([motherHenId, entryDate])
  @@map("mother_hen_logs")
}

model EggCollection {
  id             String      @id @default(cuid())
  farmId         String
  farm           Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  birdGroupId    String?
  birdGroup      BirdGroup?  @relation(fields: [birdGroupId], references: [id], onDelete: SetNull)
  collectionDate DateTime    @db.Date
  quantity       Int
  quality        EggQuality?
  createdAt      DateTime    @default(now())

  @@index([farmId, collectionDate])
  @@map("egg_collections")
}

model EggSale {
  id          String   @id @default(cuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  saleDate    DateTime @db.Date
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)
  buyer       String?
  createdAt   DateTime @default(now())

  @@index([farmId, saleDate])
  @@map("egg_sales")
}

// Eggs consumed by the household (eaten) — reduces available stock, no revenue.
model EggConsumption {
  id              String   @id @default(cuid())
  farmId          String
  farm            Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  consumptionDate DateTime @db.Date
  quantity        Int
  note            String?
  createdAt       DateTime @default(now())

  @@index([farmId, consumptionDate])
  @@map("egg_consumptions")
}

model Loss {
  id          String         @id @default(cuid())
  farmId      String
  farm        Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  birdGroupId String?
  birdGroup   BirdGroup?     @relation(fields: [birdGroupId], references: [id], onDelete: SetNull)
  lossDate    DateTime       @db.Date
  quantity    Int
  reasonType  LossReasonType
  comment     String?
  createdAt   DateTime       @default(now())

  @@index([farmId, lossDate])
  @@index([farmId, reasonType])
  @@map("losses")
}

model Expense {
  id          String          @id @default(cuid())
  farmId      String
  farm        Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  expenseDate DateTime        @db.Date
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  createdAt   DateTime        @default(now())

  @@index([farmId, expenseDate])
  @@index([farmId, category])
  @@map("expenses")
}

// Live-bird purchases and sales. Mirrors EggSale's money shape (unitPrice ×
// quantity → totalAmount, with the total stored so a hand-agreed price survives
// a later unit-price edit), and Loss's optional birdGroupId link: naming a group
// moves its head count too, leaving it null records money only.
model BirdTransaction {
  id              String              @id @default(cuid())
  farmId          String
  farm            Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  birdGroupId     String?
  birdGroup       BirdGroup?          @relation(fields: [birdGroupId], references: [id], onDelete: SetNull)
  type            BirdTransactionType
  transactionDate DateTime            @db.Date
  quantity        Int
  unitPrice       Decimal             @db.Decimal(10, 2)
  totalAmount     Decimal             @db.Decimal(10, 2)
  counterparty    String? // pirkėjas (sale) arba pardavėjas (purchase)
  note            String?
  createdAt       DateTime            @default(now())

  @@index([farmId, transactionDate])
  @@index([farmId, type])
  @@map("bird_transactions")
}

model IncubationCycle {
  id                String     @id @default(cuid())
  farmId            String
  farm              Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name              String? // nullable in DB for pre-existing rows; required on create via validation
  sourceDescription String?
  eggSourceGroupId  String?
  eggSourceGroup    BirdGroup? @relation("EggSourceGroup", fields: [eggSourceGroupId], references: [id], onDelete: SetNull)
  startDate         DateTime   @db.Date
  eggsTotal         Int?
  eggsFertile       Int?
  eggsInfertile     Int?
  hatchDate         DateTime?  @db.Date
  hatchedCount      Int?
  resultingGroupId  String?
  resultingGroup    BirdGroup? @relation("ResultingGroup", fields: [resultingGroupId], references: [id], onDelete: SetNull)
  notes             String?
  growthCompletedAt DateTime? // set when jauniklių auginimas/sekimas is finished
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  growthLogs IncubationGrowthLog[]

  @@index([farmId, startDate])
  @@map("incubation_cycles")
}

model IncubationGrowthLog {
  id                String          @id @default(cuid())
  incubationCycleId String
  incubationCycle   IncubationCycle @relation(fields: [incubationCycleId], references: [id], onDelete: Cascade)
  logDate           DateTime        @db.Date
  aliveCount        Int
  note              String?
  createdAt         DateTime        @default(now())

  @@index([incubationCycleId, logDate])
  @@map("incubation_growth_logs")
}
