# Neon Postgres connection string (unpooled/direct is recommended so `prisma migrate` works reliably).
# Get this from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@ep-example-12345.eu-central-1.aws.neon.tech/chickensfarm?sslmode=require"

# NextAuth / Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Resend (transactional email for password reset). Optional in dev — if unset,
# reset links are logged to the console instead of emailed.
RESEND_API_KEY=""
EMAIL_FROM="ChickensFarm <onboarding@resend.dev>"

# Vercel Blob (Phase 2 — mother hen photos). Not required for Phase 1.
BLOB_READ_WRITE_TOKEN=""

# Daily reminders. CRON_SECRET is the shared token the scheduled GitHub Actions
# workflow sends as `Authorization: Bearer ...`; the same value must be set as a
# repository secret. Without it /api/cron/reminders answers 503 and no reminder
# is ever sent. Generate with `openssl rand -base64 32`.
CRON_SECRET=""

# Web push (phone notifications). Free — the keys are self-generated and delivery
# goes straight to the browser vendors' own endpoints, with no account anywhere.
# If any of these is unset, the phone toggle renders disabled and no push is sent;
# email reminders keep working.
#
# Generate offline, with Node alone (no network, no global install):
#   node -e 'const c=require("node:crypto");
#   const {privateKey}=c.generateKeyPairSync("ec",{namedCurve:"prime256v1"});
#   const j=privateKey.export({format:"jwk"});
#   console.log("VAPID_PUBLIC_KEY="+Buffer.concat([Buffer.from([4]),
#     Buffer.from(j.x,"base64url"),Buffer.from(j.y,"base64url")]).toString("base64url"));
#   console.log("VAPID_PRIVATE_KEY="+j.d);'
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Contact URI so a push service can reach you about problems. Must start with
# `mailto:` or `https://` — angle brackets are rejected. Falls back to APP_URL
# when that is an https URL, so production usually needs only the two keys.
VAPID_SUBJECT=""

# Absolute base URL used for links inside emails. A cron request has no
# user-facing origin to derive one from, and deriving it from the request Host
# would be spoofable. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL;
# set it explicitly for Production. If unset, reminder emails omit the link.
APP_URL=""

# Sentry error tracking (issue #74). All optional — unset in dev/CI, Sentry
# is initialized with `enabled: false` (src/sentry.server.config.ts,
# src/sentry.edge.config.ts, src/instrumentation-client.ts) and reports
# nothing rather than erroring. Get these from a free Sentry project
# (https://sentry.io) under Settings -> Client Keys (DSN) once created; see
# docs/monitoring.md for the full setup.
#
# Server/edge runtime DSN.
SENTRY_DSN=""
# Browser DSN. Usually the same value as SENTRY_DSN — it's exposed to the
# client bundle (hence NEXT_PUBLIC_), which is expected for a Sentry DSN.
NEXT_PUBLIC_SENTRY_DSN=""

# Only needed to enable source map upload at build time (readable stack
# traces in Sentry instead of minified ones). Optional — next.config.ts skips
# the upload entirely when this is unset, so builds without it (local, CI)
# are unaffected. Generate at
# https://sentry.io/orgredirect/organizations/:org/settings/auth-tokens/.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
